-                titleBn = titleBn,
-                amount = amount,
-                type = "Donation",
-                monthYear = "July 2026",
-                date = "2026-07-25",
-                paymentGateway = paymentGateway,
-                transactionId = transactionId,
-                status = "Completed"
-            )
-            firestoreRepository.addFinancialRecord(donationRecord)
-            clubRepository.insertFinancialRecord(donationRecord)
-            _isLoading.value = false
-        }
-    }
-}
